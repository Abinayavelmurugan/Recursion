class Solution {
    void solve(int i, int j,ArrayList<String> res, String str,int[][] a,int[][] v, int n, int[] di, int [] dj){
        if(i==n-1 && j==n-1){
            res.add(str);
            return;
        }
        String dir="DLRU";
        for(int ind=0;ind<4;ind++){
            int tempi=i+di[ind];
            int tempj=j+dj[ind];
            if(tempi>=0 && tempj>=0 && tempi<n && tempj<n && v[i][j]!=1 && a[tempi][tempj]==1){
                v[i][j]=1;
                solve(tempi,tempj,res,str+dir.charAt(ind),a,v,n,di,dj);
                v[i][j]=0;
            }
        }
    }
    public ArrayList<String> findPath(int[][] mat) {
        ArrayList<String> res=new ArrayList<>();
        int[] di={1,0,0,-1};
        int[] dj={0,-1,1,0};
        int n=mat.length;
        int vis[][] = new int[n][n];
    for (int i = 0; i < n; i++) {
      for (int j = 0; j < n; j++) {
        vis[i][j] = 0;
      }
    }
        if(mat[0][0]==1){
            solve(0,0,res,"",mat,vis,mat.length,di,dj);
        }
        return res;
    }
}
